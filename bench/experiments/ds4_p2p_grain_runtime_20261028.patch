+        p_->reset();ds4_experiment_transport(mode);
+        std::string e;
+        if(feed(&token,1,1,e) || e.find("reload")==std::string::npos) {err="feed accepted poisoned state";return false;}
+        e.clear();
+        if(feed_mark(&token,1,1,0,e) || e.find("reload")==std::string::npos) {err="feed_mark accepted poisoned state";return false;}
+        e.clear();
+        if(p_->forward(&token,1,1,e) || e.find("reload")==std::string::npos) {err="forward accepted poisoned state";return false;}
+        e.clear();
+        if(p_->forward_chunks(&token,1,1,e) || e.find("reload")==std::string::npos) {err="chunk feed accepted poisoned state";return false;}
+        std::vector<int> drafts;std::vector<float> conf;e.clear();
+        if(draft(token,drafts,conf,e) || e.find("reload")==std::string::npos) {err="draft accepted poisoned state";return false;}
+        int accepted=0,next=0;e.clear();
+        if(verify(token,drafts,0.f,1.f,1,0.f,1,0,accepted,next,e) || e.find("reload")==std::string::npos) {err="verify accepted poisoned state";return false;}
